# Copy to .env and fill in. .env is gitignored — never commit real keys.
#   cp .env.example .env
#
# Stage 0 needs only RAG_CORE_SHARED_SECRET. AI provider keys are unused until
# the stage that introduces them; leaving them blank only produces a startup warning.

# --- runtime ---
ENV=development
LOG_LEVEL=info

# --- service wiring ---
API_PORT=8080
RAG_CORE_PORT=8000
RAG_CORE_URL=http://rag-core:8000
# REQUIRED. Shared secret for the api -> rag-core trust boundary.
# Generate with:  openssl rand -hex 32
RAG_CORE_SHARED_SECRET=
PUBLIC_API_URL=http://localhost:8080

# --- qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base

# --- AI providers ---
EMBEDDING_PROVIDER=voyage          # voyage | openai
EMBEDDING_MODEL=voyage-4-lite
EMBEDDING_DIMENSIONS=1024          # voyage-4-lite supports 256 / 512 / 1024 / 2048
VOYAGE_API_KEY=
VOYAGE_MAX_BATCH_TOKENS=8000       # free-tier 10K TPM cap - a single large doc's chunks
                                   # embedded in one call can exceed it on its own
VOYAGE_BATCH_DELAY_SECONDS=21      # pacing between batches to also respect 3 RPM
OPENAI_API_KEY=
RERANK_PROVIDER=cohere             # cohere | local (later)
RERANK_MODEL=rerank-v3.5
COHERE_API_KEY=
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-sonnet-5
QUERY_REWRITE_MODEL=claude-haiku-4-5
GENERATION_MAX_TOKENS=1500         # grounded answers should be concise, not the SDK's generic default
GENERATION_EFFORT=low              # low | medium | high | xhigh | max - cost lever, raise only if quality needs it

# --- retrieval / cost-control knobs ---
RETRIEVAL_SCORE_FLOOR=0.35
RETRIEVE_TOP_K=20                  # hybrid (dense+sparse RRF) candidate pool size, pre-rerank
RERANK_TOP_N=5                     # final chunk count after Cohere reranks the candidate pool

# --- hosted-demo ingestion gate ---
INGEST_ENABLED=true               # set false (or protect with INGEST_API_KEY) on the public demo
INGEST_API_KEY=

# --- web frontend (Stage 10) ---
WEB_ORIGIN=http://localhost:3000  # CORS allow for the Next.js frontend's origin
NEXT_PUBLIC_API_URL=http://localhost:8080  # api base URL the browser calls directly

# --- ingestion (Stage 1) ---
SQLITE_PATH=data/registry.db      # relative to the rag-core working dir; see rag_core_data volume
STORAGE_DIR=data/storage          # original uploaded/fetched files, for citation click-through
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_RATIO=0.15
